# public/ dir assets (workflow images etc) load same-origin through tunee.ai/features/_public/*
# (the site is reverse-proxied at tunee.ai/features/... only; next.config rewrites _public to /).
# Must be absolute: og:image and JSON-LD use it.
NEXT_PUBLIC_ASSET_PREFIX=https://www.tunee.ai/features/_public

# GA4 measurement ID（属性 495906931，与主站 app 共用）。
# 不配这个变量就不上报——GoogleAnalytics 组件会直接返回 null。
NEXT_PUBLIC_GA4_ID=G-DZWQV1QHJC
